	<act:generator>
		<act:action>TA_ACCESS_PE_CREATE</act:action>
		<act:condition>(boolean(count(/root/service[state='PENDING']) > 0) and
			(/root/after/Device_Access/mediaType = 'Fiber') or
			(/root/after/Device_Access/mediaType = 'GPON') or
			(/root/after/Device_Access/mediaType = 'Microwave'))
		</act:condition>
		<act:subject>/root/service</act:subject>
		<act:target>/root/service</act:target>
		<act:binding>
			<act:parameter>mediaType</act:parameter>
			<act:path>/root/after/Device_Access/mediaType</act:path>
		</act:binding>
		<act:binding>
			<act:parameter>peDeviceName</act:parameter>
			<act:path>/root/after/Device_Access/PE_Device/Assignment[@State='PENDING_ASSIGN']/name
			</act:path>
		</act:binding>

	</act:generator>

